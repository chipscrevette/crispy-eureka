{
  "layers": {
    "sentinel2_l2a": {
      "band_sets": [{
        "bands": ["B01", "B02", "B03", "B04", "B05", "B06", "B07", "B08", "B8A", "B09", "B11", "B12"],
        "dtype": "uint16"
      }],
      "data_source": {
        "class_path": "rslearn.data_sources.planetary_computer.Sentinel2",
        "init_args": {"harmonize": true, "sort_by": "eo:cloud_cover"},
        "ingest": false,
        "query_config": {"max_matches": 4, "period_duration": "90d", "space_mode": "MOSAIC"}
      },
      "type": "raster"
    },
    "embeddings": {
      "band_sets": [{"dtype": "float32", "num_bands": 192}],
      "type": "raster"
    }
  }
}
